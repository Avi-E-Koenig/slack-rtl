{
  "manifest_version": 3,
  "name": "Slack RTL: copy list numbers",
  "version": "0.1.0",
  "description": "Optional add-on: keeps 1., 2., … when copying numbered lists out of Slack messages.",
  "homepage_url": "https://github.com/Avi-E-Koenig/slack-rtl",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "slack-rtl-copy-list-numbers@avi-e-koenig",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
